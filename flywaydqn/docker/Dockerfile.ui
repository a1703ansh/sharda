# FlywayDQN dashboard: the Vite production build, served as static files.
#
# The build context is the repository root, not this directory:
#   docker compose -f docker/demo-compose.yaml up --build
#   docker build -f docker/Dockerfile.ui -t flywaydqn-ui .
FROM node:20-alpine AS builder

WORKDIR /app

# Dependency manifest first, so editing source does not re-run `npm ci`.
COPY ui/package.json ui/package-lock.json ./
RUN npm ci

# `tsconfig.json` is required, not optional: the build script is
# `tsc && vite build`.
COPY ui/tsconfig.json ui/vite.config.ts ui/index.html ./
COPY ui/src ./src

# Vite inlines `VITE_API_BASE` at build time, so it has to be a build argument;
# a runtime container variable would arrive too late to change the bundle. It
# must be a URL the *browser* can reach -- the published backend port on the
# host, not a compose service name.
ARG VITE_API_BASE=http://localhost:8000
ENV VITE_API_BASE=${VITE_API_BASE}
RUN npm run build

FROM nginx:alpine AS runtime

COPY ui/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
