# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
# Python 3.11 env created by `uv venv .venv311 --python 3.11` (the pinned interpreter).
.venv311/

# --- Local run artifacts ---
# Server/UI logs written by whichever terminal started the demo, e.g.
# `PYTHONPATH=src python -m uvicorn ... > backend.log 2>&1`. Nothing tracked is a
# .log file, and generated experiment logs are already covered below.
*.log

# --- Tooling caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/

# `uv.lock` is not tracked: `make setup` regenerates it from pyproject.toml.
# The versions every reported number was actually produced with are recorded
# instead in `requirements.lock.txt`, which is tracked on purpose.
*.lock

# --- Secrets ---
.env
.env.*
!.env.example

# --- Generated experiment outputs ---
# Figures are the Phase 1 acceptance artifact and are tracked. Raw sweeps and
# per-run tables are regenerated by `make eval`, so they stay out of git.
experiments/**/*.csv
experiments/**/*.json
experiments/**/*.parquet
experiments/**/*.log

# ...with one exception: `baselines.md` states that every number in it is an
# aggregate of `baselines.csv`, so that CSV has to travel with it or the claim
# cannot be checked from the repository alone.
!experiments/results/baselines.csv

# --- UI ---
ui/node_modules/
ui/dist/
ui/.vite/
ui/.next/
*.tsbuildinfo

# --- Accidental browser page saves ---
# These are not project artifacts: they are saved Google sign-in pages that got
# captured while browsing. They are large (~900 kB each) and contain no project
# content. Kept out of version control on purpose. Real dashboard captures should
# be produced from the running UI (spec Section 12, correction 1).
ui/beam_steering_console.html
ui/dqn_policy_inspector.html
ui/flyway_surveillance.html
ui/phased_array_grid.html

# Trained checkpoints are regenerated by `python -m flywaydqn.agents.train_dqn`;
# they are build artifacts, not sources.
experiments/checkpoints/
